# Token du tunnel Cloudflare : Zero Trust dashboard > Networks > Tunnels >
# [ton tunnel] > Configure > Docker. Copier uniquement la valeur après "--token".
CLOUDFLARE_TUNNEL_TOKEN=

# Optionnel : active le "mode IA" pour la génération de CV/lettre (sinon moteur
# mécanique par mots-clés, 100% local). Laisser vide pour désactiver un fournisseur.
# GEMINI_API_KEY : clé gratuite disponible sur aistudio.google.com (aucune carte
# bancaire requise, quotas quotidiens généreux sur Gemini Flash).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
